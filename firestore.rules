rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Personal notes ----------
    // Bondline keeps each person's data in users/{their id}/notes.
    // Only that person can read or change it, and every write is checked for shape and size.
    match /users/{uid}/notes/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validDoc(docId, request.resource.data);
    }

    // ---------- Read-only share links ----------
    // Anyone with a link can open that one shared copy,
    // but nobody can list them, and only the owner can create, update or delete it.
    match /shares/{shareId} {
      allow get: if shareId.size() >= 10 && shareId.size() <= 40;
      allow list: if false;
      allow create: if request.auth != null && validShare(request.resource.data);
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && validShare(request.resource.data);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // ---------- Shared notebooks ----------
    // Members can read everything in a notebook. Editors (and the owner) can change notes;
    // viewers can only add comments. Only the owner can invite, remove people or delete it.
    match /notebooks/{nb} {
      allow get: if signedIn() && (request.auth.uid in resource.data.memberIds || isInvited(resource.data));
      allow list: if signedIn() && (request.auth.uid in resource.data.memberIds || isInvited(resource.data));
      allow create: if signedIn() && validNewNotebook(request.resource.data);
      allow update: if signedIn() && validNotebook(request.resource.data)
                    && (ownerUpdate() || joinByLink(nb) || joinByEmail() || leave() || declineInvite());
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /notes/{noteId} {
        allow read: if isMember(nb);
        allow create: if canEdit(nb) && validSharedNote(request.resource.data);
        allow update: if validSharedNote(request.resource.data)
                      && (canEdit(nb) || (isMember(nb) && onlyComments()));
        allow delete: if canEdit(nb);
      }
      match /blocks/{blockId} {
        allow read: if isMember(nb);
        allow create, update: if canEdit(nb) && validBlock(request.resource.data);
        allow delete: if canEdit(nb);
      }
      match /presence/{uid} {
        allow read: if isMember(nb);
        allow create, update: if signedIn() && request.auth.uid == uid && isMember(nb) && validPresence(request.resource.data);
        allow delete: if signedIn() && (request.auth.uid == uid || get(/databases/$(database)/documents/notebooks/$(nb)).data.owner == request.auth.uid);
      }
    }

    // Invite links. Anyone signed in who has the (long, random) link can read that one invite.
    // Only the notebook's owner can make one.
    match /invites/{key} {
      allow get: if signedIn() && key.size() >= 20;
      allow list: if false;
      allow create: if signedIn() && key.size() >= 20 && validInvite(request.resource.data)
                    && get(/databases/$(database)/documents/notebooks/$(request.resource.data.nb)).data.owner == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isInvited(d) {
      return request.auth.token.email_verified == true && myEmail() in d.inviteEmails;
    }

    function nbData(nb) {
      return get(/databases/$(database)/documents/notebooks/$(nb)).data;
    }

    function isMember(nb) {
      return signedIn() && request.auth.uid in nbData(nb).memberIds;
    }

    function canEdit(nb) {
      return isMember(nb) && nbData(nb).roles[request.auth.uid] in ['owner', 'editor'];
    }

    function validNotebook(d) {
      return d.keys().hasOnly(['name', 'owner', 'roles', 'people', 'memberIds', 'inviteEmails', 'inviteEditors', 'at', 'joinKey', 'linkKey', 'linkRole'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.owner is string
          && d.roles is map && d.roles.size() <= 100
          && d.people is map && d.people.size() <= 100
          && d.memberIds is list && d.memberIds.size() <= 100
          && d.inviteEmails is list && d.inviteEmails.size() <= 100
          && d.inviteEditors is list && d.inviteEditors.size() <= 100
          && d.roles[d.owner] == 'owner'
          && d.owner in d.memberIds;
    }

    function validNewNotebook(d) {
      return validNotebook(d)
          && d.owner == request.auth.uid
          && d.memberIds == [request.auth.uid]
          && d.roles.keys().hasOnly([request.auth.uid])
          && d.inviteEmails.size() == 0 && d.inviteEditors.size() == 0;
    }

    // The owner can change anything except who owns it.
    function ownerUpdate() {
      return resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner;
    }

    // Someone with a valid invite link adds only themselves, with the link's role.
    function joinByLink(nb) {
      let d = request.resource.data;
      let o = resource.data;
      let me = request.auth.uid;
      return ('joinKey' in d)
          && !(me in o.memberIds)
          && get(/databases/$(database)/documents/invites/$(d.joinKey)).data.nb == nb
          && get(/databases/$(database)/documents/invites/$(d.joinKey)).data.on == true
          && d.diff(o).affectedKeys().hasOnly(['roles', 'people', 'memberIds', 'joinKey'])
          && d.roles.diff(o.roles).affectedKeys().hasOnly([me])
          && d.roles[me] == get(/databases/$(database)/documents/invites/$(d.joinKey)).data.role
          && d.people.diff(o.people).affectedKeys().hasOnly([me])
          && d.memberIds.toSet() == o.memberIds.toSet().union([me].toSet())
          && d.memberIds.size() == o.memberIds.size() + 1;
    }

    // Someone invited by (verified) email adds only themselves and clears their invitation.
    function joinByEmail() {
      let d = request.resource.data;
      let o = resource.data;
      let me = request.auth.uid;
      return isInvited(o)
          && !(me in o.memberIds)
          && d.diff(o).affectedKeys().hasOnly(['roles', 'people', 'memberIds', 'inviteEmails', 'inviteEditors'])
          && d.roles.diff(o.roles).affectedKeys().hasOnly([me])
          && d.roles[me] == (myEmail() in o.inviteEditors ? 'editor' : 'viewer')
          && d.people.diff(o.people).affectedKeys().hasOnly([me])
          && d.memberIds.toSet() == o.memberIds.toSet().union([me].toSet())
          && d.memberIds.size() == o.memberIds.size() + 1
          && d.inviteEmails.toSet() == o.inviteEmails.toSet().difference([myEmail()].toSet())
          && d.inviteEditors.toSet() == o.inviteEditors.toSet().difference([myEmail()].toSet());
    }

    // A member (not the owner) removes only themselves.
    function leave() {
      let d = request.resource.data;
      let o = resource.data;
      let me = request.auth.uid;
      return me in o.memberIds && me != o.owner
          && d.diff(o).affectedKeys().hasOnly(['roles', 'people', 'memberIds'])
          && !(me in d.roles) && !(me in d.memberIds)
          && d.roles.diff(o.roles).affectedKeys().hasOnly([me])
          && d.people.diff(o.people).affectedKeys().hasOnly([me])
          && d.memberIds.toSet() == o.memberIds.toSet().difference([me].toSet());
    }

    // Someone invited by email turns the invitation down.
    function declineInvite() {
      let d = request.resource.data;
      let o = resource.data;
      return isInvited(o)
          && d.diff(o).affectedKeys().hasOnly(['inviteEmails', 'inviteEditors'])
          && d.inviteEmails.toSet() == o.inviteEmails.toSet().difference([myEmail()].toSet())
          && d.inviteEditors.toSet() == o.inviteEditors.toSet().difference([myEmail()].toSet());
    }

    function validSharedNote(d) {
      return d.keys().hasOnly(['title', 'tags', 'comments', 'updated', 'by'])
          && d.title is string && d.title.size() <= 500
          && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20))
          && (!('comments' in d) || (d.comments is list && d.comments.size() <= 500))
          && d.updated is number
          && d.by == request.auth.uid;
    }

    function onlyComments() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'updated', 'by']);
    }

    function validBlock(d) {
      return d.keys().hasOnly(['note', 'pos', 'b', 'u', 'by'])
          && d.note is string && d.note.size() <= 100
          && d.pos is number
          && d.b is map
          && d.u is number
          && d.by == request.auth.uid;
    }

    function validPresence(d) {
      return d.keys().hasOnly(['note', 'at', 'n'])
          && d.note is string && d.note.size() <= 100
          && d.at is number
          && d.n is string && d.n.size() <= 80;
    }

    function validInvite(d) {
      return d.keys().hasOnly(['nb', 'role', 'by', 'name', 'from', 'on', 'at'])
          && d.nb is string && d.nb.size() <= 40
          && d.role in ['editor', 'viewer']
          && d.by == request.auth.uid
          && d.on == true
          && d.name is string && d.name.size() <= 100
          && d.from is string && d.from.size() <= 100
          && d.at is number;
    }

    function validShare(d) {
      return d.keys().hasOnly(['owner', 'at', 'note'])
          && d.owner == request.auth.uid
          && d.at is number
          && d.note is map
          && d.note.keys().hasOnly(['title', 'tags', 'blocks', 'updated'])
          && d.note.blocks is list && d.note.blocks.size() <= 400;
    }

    function validDoc(docId, d) {
      return (docId == '_meta'
                && d.keys().hasOnly(['dismissed', 'folders', 'foldersAt'])
                && d.dismissed is list && d.dismissed.size() <= 500
                && (!('folders' in d) || (d.folders is list && d.folders.size() <= 300))
                && (!('foldersAt' in d) || d.foldersAt is number))
          || (docId == '_quiz'
                && d.keys().hasOnly(['v', 'q'])
                && d.q is map && d.q.size() <= 2000)
          || (docId == '_gloss'
                && d.keys().hasOnly(['v', 'at', 'terms'])
                && d.terms is list && d.terms.size() <= 500
                && d.at is number)
          || (docId != '_meta' && docId != '_quiz' && docId != '_gloss'
                && docId.size() <= 100
                && d.keys().hasOnly(['title', 'tag', 'tags', 'folder', 'pinned', 'comments', 'deleted', 'share', 'updated', 'blocks'])
                && d.title is string && d.title.size() <= 500
                && d.tag is string && d.tag.size() <= 100
                && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20))
                && (!('folder' in d) || (d.folder is string && d.folder.size() <= 40))
                && (!('pinned' in d) || d.pinned is bool)
                && (!('comments' in d) || (d.comments is list && d.comments.size() <= 500))
                && (!('deleted' in d) || d.deleted is number)
                && (!('share' in d) || (d.share is string && d.share.size() <= 40))
                && d.updated is number
                && d.blocks is list && d.blocks.size() <= 400);
    }

    // ---------- Classes (version 16) ----------
    // A lecturer owns a class. Students join with its 8-character code, which only members can see.
    // Members read the class and its assignments. Students' names, emails and results are readable
    // only by the lecturer and by that student.
    match /classes/{cid} {
      allow get, list: if signedIn() && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.memberIds);
      allow create: if signedIn() && validNewClass(request.resource.data);
      allow update: if signedIn() && validClass(request.resource.data) && (classOwnerUpdate() || classJoin() || classLeave());
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /assignments/{aid} {
        allow read: if isClassOwner(cid) || isClassMember(cid);
        allow create, update: if isClassOwner(cid) && validAssignment(request.resource.data);
        allow delete: if isClassOwner(cid);
      }
      // Each student's name and email: readable only by the lecturer and that student.
      match /members/{uid} {
        allow read: if isClassOwner(cid) || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid && isClassMember(cid)
                              && request.resource.data.keys().hasOnly(['n', 'e', 'at'])
                              && request.resource.data.n is string && request.resource.data.n.size() <= 80
                              && request.resource.data.e is string && request.resource.data.e.size() <= 120
                              && request.resource.data.at is number;
        allow delete: if isClassOwner(cid) || (signedIn() && request.auth.uid == uid);
      }
      match /results/{rid} {
        allow get: if isClassOwner(cid) || (signedIn() && (resource == null || resource.data.uid == request.auth.uid));
        allow list: if isClassOwner(cid) || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if isClassMember(cid) && validResult(cid, rid, request.resource.data);
        allow delete: if isClassOwner(cid) || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // Class codes point to a class. Anyone signed in can look up one code they already know, but nobody can list them.
    match /classCodes/{code} {
      allow get: if signedIn() && code.size() == 8;
      allow list, update: if false;
      allow create: if signedIn() && code.size() == 8
                    && request.resource.data.keys().hasOnly(['cid', 'by', 'at'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.cid is string
                    && classData(request.resource.data.cid).owner == request.auth.uid
                    && classData(request.resource.data.cid).code == code;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    function classData(cid) {
      return get(/databases/$(database)/documents/classes/$(cid)).data;
    }

    function isClassOwner(cid) {
      return signedIn() && classData(cid).owner == request.auth.uid;
    }

    function isClassMember(cid) {
      return signedIn() && request.auth.uid in classData(cid).memberIds;
    }

    function validClass(d) {
      return d.keys().hasOnly(['name', 'owner', 'ownerName', 'code', 'memberIds', 'at', 'lastJoin'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.owner is string
          && d.ownerName is string && d.ownerName.size() <= 80
          && d.code is string && d.code.size() == 8
          && d.memberIds is list && d.memberIds.size() <= 300
          && d.at is number
          && (!('lastJoin' in d) || (d.lastJoin is string && d.lastJoin.size() <= 200))
          && !(d.owner in d.memberIds);
    }

    function validNewClass(d) {
      return validClass(d)
          && d.owner == request.auth.uid
          && d.memberIds.size() == 0
          && !('lastJoin' in d);
    }

    // The lecturer can rename the class and remove students, but can't add anyone or change the code.
    function classOwnerUpdate() {
      let d = request.resource.data;
      let o = resource.data;
      return o.owner == request.auth.uid
          && d.owner == o.owner && d.code == o.code
          && d.diff(o).affectedKeys().hasOnly(['name', 'ownerName', 'memberIds'])
          && o.memberIds.toSet().hasAll(d.memberIds);
    }

    // A student adds only themselves, and proves they know the code by writing "<code>:<their id>".
    function classJoin() {
      let d = request.resource.data;
      let o = resource.data;
      let me = request.auth.uid;
      return !(me in o.memberIds) && me != o.owner
          && d.lastJoin == o.code + ':' + me
          && d.diff(o).affectedKeys().hasOnly(['memberIds', 'lastJoin'])
          && d.memberIds.toSet() == o.memberIds.toSet().union([me].toSet())
          && d.memberIds.size() == o.memberIds.size() + 1;
    }

    // A student removes only themselves.
    function classLeave() {
      let d = request.resource.data;
      let o = resource.data;
      let me = request.auth.uid;
      return me in o.memberIds
          && d.diff(o).affectedKeys().hasOnly(['memberIds'])
          && d.memberIds.toSet() == o.memberIds.toSet().difference([me].toSet());
    }

    function validAssignment(d) {
      return d.keys().hasOnly(['title', 'kind', 'cfg', 'due', 'at', 'by'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.kind in ['naming', 'spectra', 'mech', 'synth']
          && d.cfg is map && d.cfg.keys().hasOnly(['topics', 'len', 'style', 'ids'])
          && (!('topics' in d.cfg) || (d.cfg.topics is list && d.cfg.topics.size() <= 12))
          && (!('ids' in d.cfg) || (d.cfg.ids is list && d.cfg.ids.size() <= 40))
          && (!('len' in d.cfg) || (d.cfg.len is int && d.cfg.len > 0 && d.cfg.len <= 50))
          && (!('style' in d.cfg) || (d.cfg.style is string && d.cfg.style.size() <= 10))
          && (d.due == null || d.due is number)
          && d.at is number
          && d.by == request.auth.uid;
    }

    function validResult(cid, rid, d) {
      return d.keys().hasOnly(['aid', 'uid', 'n', 'e', 'score', 'total', 'best', 'tries', 'at'])
          && d.uid == request.auth.uid
          && d.aid is string && d.aid.size() <= 40
          && rid == d.aid + '_' + request.auth.uid
          && d.n is string && d.n.size() <= 80
          && d.e is string && d.e.size() <= 120
          && d.score is int && d.total is int && d.best is int && d.tries is int
          && d.total >= 1 && d.total <= 500
          && d.score >= 0 && d.score <= d.total
          && d.best >= 0 && d.best <= d.total
          && d.tries >= 1 && d.tries <= 100000
          && d.at is number
          && exists(/databases/$(database)/documents/classes/$(cid)/assignments/$(d.aid));
    }

    // Everything else is closed.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
